@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>HoGiaNghia_FE</title>
    <style>
        
        * {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

      
        body {
         background-color: #f4f4f4;
        }

        /* Phần Header */
        header {
            background-color: #131921; 
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 30px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .search-bar {
            display: flex;
            align-items: center;
            flex-grow: 1;
            max-width: 600px;
            margin: 0 30px;
        }

            .search-bar input {
                padding: 10px 15px;
                width: 100%;
                border: none;
                border-radius: 4px;
                outline: none;
                font-size: 15px;
            }

        .user-actions span {
            margin-left: 25px;
            cursor: pointer;
        }

            .user-actions span:hover {
                color: #febd69; 
            }

        
        .container {
            display: flex;
            max-width: 1200px;
            margin: 30px auto;
            gap: 25px;
            padding: 0 20px;
        }

        
        .sidebar {
            width: 250px;
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            height: fit-content;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05); /* Thêm đổ bóng nhẹ cho đẹp */
        }

            .sidebar h3 {
                margin-bottom: 15px;
                color: #131921;
            }

            .sidebar ul {
                list-style: none;
            }

                .sidebar ul li {
                    margin-bottom: 12px;
                }

                    .sidebar ul li a {
                        text-decoration: none;
                        color: #555;
                        transition: color 0.2s;
                    }

                        .sidebar ul li a:hover {
                            color: #e47911;
                            font-weight: bold;
                        }

        /* Danh sách sản phẩm */
        .product-list {
            flex-grow: 1;
        }

            .product-list h2 {
                margin-bottom: 20px;
                font-size: 22px;
                color: #333;
            }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 20px;
        }

        .product-card {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #eaeaea;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }


            .product-card img {
                width: 100%;
                height: 200px; 
                object-fit: cover; /* Cắt cúp ảnh gọn gàng nếu sai tỷ lệ */
                margin-bottom: 15px;
                border-radius: 4px;
            }

        .product-title {
            font-size: 16px;
            color: #007185;
            margin-bottom: 15px;
            line-height: 1.4;
        }

        .product-price {
            font-size: 22px;
            font-weight: bold;
            color: #B12704; 
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <i class="fab fa-amazon"></i> MyStore
        </div>
        <div class="search-bar">
            <input type="text" placeholder="Tìm kiếm sản phẩm...">
        </div>
        <div class="user-actions">
            <span><i class="fas fa-user"></i> Tài khoản</span>
            <span><i class="fas fa-shopping-cart"></i> Giỏ hàng</span>
        </div>
    </header>

    <main class="container">
        <aside class="sidebar">
            <h3>Danh mục</h3>
            <ul>
                <li><a href="#">Đồ gia dụng</a></li>
                <li><a href="#">Thiết bị điện tử</a></li>
                <li><a href="#">Thời trang</a></li>
                <li><a href="#">Sức khỏe & Làm đẹp</a></li>
            </ul>
        </aside>

        <section class="product-list">
            <h2>Kết quả tìm kiếm</h2>
            <div class="grid-container">
                
                <div class="product-card">
                    <img src="https://media.hcdn.vn/wysiwyg/minhchau/ban-chai-dien-p-s-s100-pro-cong-nghe-song-am-1.jpg" alt="Sản phẩm 1">
                    <h4 class="product-title">Bàn chải điện cao cấp đa năng</h4>
                    <p class="product-price">$39.99</p>
                </div>

                <div class="product-card">
                    <img src="https://tse1.mm.bing.net/th/id/OIP.7TFiG1-Ig8zNVFbUHpAiigHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" alt="Sản phẩm 2">
                    <h4 class="product-title">Máy hút bụi mini không dây</h4>
                    <p class="product-price">$49.00</p>
                </div>

                <div class="product-card">
                    <img src="https://tse1.mm.bing.net/th/id/OIP.CORRbSFLSifgsFlpIliIQQHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" alt="Sản phẩm 3">
                    <h4 class="product-title">Chổi cọ rửa nhà tắm xoay 360 độ</h4>
                    <p class="product-price">$35.00</p>
                </div>

                <div class="product-card">
                    <img src="https://tse3.mm.bing.net/th/id/OIP.BgngQMuRH-3Nqp4VvLOdLQHaHa?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" alt="Sản phẩm 4">
                    <h4 class="product-title">Bộ dụng cụ vệ sinh nhà cửa</h4>
                    <p class="product-price">$22.50</p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
